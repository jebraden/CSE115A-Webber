  <property name="windowTitle"><string>Webber</string></property>
  <property name="styleSheet"><string notr="true">
QWidget { background: #f8f8f6; color: #292929; font-size: 13px; }
QLabel { background: transparent; }
QWidget#navigationBar, QWidget#capturePanel { background: #efefed; border-bottom: 1px solid #cececa; }
QLabel#brandLabel { background: transparent; color: #566446; font-size: 22px; font-weight: 600; padding: 0 8px 0 0; }
QPushButton { min-height: 18px; padding: 8px 12px; border: 1px solid #cececa; border-radius: 8px; background: #f1f1ee; }
QPushButton#sidebarToggle { padding: 5px; border: none; background: transparent; }
QPushButton#sidebarToggle:hover { background: #e9ecdf; }
QPushButton:hover { background: #e9ecdf; }
QPushButton:checked { background: #e3e8d6; color: #435435; border-color: #b7c4a7; }
QPushButton:focus { border-color: #879b76; }
QPushButton#savePageButton, QPushButton#captureButton { background: #566446; color: #ffffff; border-color: #566446; }
QPushButton#savePageButton:hover, QPushButton#captureButton:hover { background: #4b5a3d; border-color: #4b5a3d; }
QPushButton#savePageButton:pressed, QPushButton#captureButton:pressed { background: #414f35; border-color: #414f35; }
QPushButton:disabled { color: #92928e; }
QLineEdit { background: #f1f1ee; border: 1px solid #cececa; border-radius: 8px; padding: 8px 12px; selection-background-color: #d7dfc8; }
QWidget#archivePanel { background: #f4f4f1; }
QLabel#archiveHeading { background: transparent; font-size: 18px; font-weight: 500; }
QLabel#archiveCount, QLabel#snapshotDate, QLabel#offlineLabel, QLabel#previewLabel { background: transparent; color: #737370; font-size: 11px; }
QListWidget { border: none; background: #f4f4f1; padding: 3px; outline: 0; }
QListWidget::item { border: 1px solid transparent; border-bottom-color: #dededb; border-radius: 8px; padding: 12px 40px 12px 12px; margin: 3px 0; }
QListWidget::item:selected { background: #e3e8d6; color: #36442b; border-color: #b7c4a7; }
QListWidget::item:hover:!selected { background: #e9ecdf; }
QWidget#readerBar, QWidget#addressBar { border-bottom: 1px solid #e3e3df; }
QLabel#currentUrl { color: #737370; font-size: 12px; }
QLabel#emptyMessage { color: #737370; font-size: 15px; }
QPlainTextEdit { border: none; padding: 16px; background: #f8f8f6; color: #41413e; font-family: monospace; }
QSplitter::handle { background: #cececa; width: 1px; }
QSplitter::handle:hover { background: #879b76; }
QStatusBar { background: #efefed; color: #737370; border-top: 1px solid #cececa; }
QStatusBar::item { border: none; }
QLabel#settingsHeading { font-size: 22px; font-weight: 500; }
QLabel#webpageHeading { font-size: 15px; margin-top: 20px; }
QLabel#viewingDescription { color: #737370; font-size: 12px; }
QSpinBox { min-height: 18px; background: #f1f1ee; color: #292929; padding: 8px 12px; border: 1px solid #cececa; border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
QPushButton#zoomDecrease, QPushButton#textSizeDecrease { background: #f1f1ee; border-radius: 0; border-left: none; padding: 6px; font-size: 19px; }
QPushButton#zoomIncrease, QPushButton#textSizeIncrease { background: #f1f1ee; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-left: none; padding: 6px; font-size: 19px; }
QPushButton#zoomDecrease:hover, QPushButton#zoomIncrease:hover, QPushButton#textSizeDecrease:hover, QPushButton#textSizeIncrease:hover { background: #e9ecdf; }
QSpinBox QLineEdit { padding: 0; border: none; background: transparent; color: #292929; border-radius: 0; }
QSpinBox:focus, QLineEdit:focus, QComboBox:focus { border-color: #879b76; }
QComboBox { min-height: 18px; background: #f1f1ee; color: #292929; padding: 8px 12px; border: 1px solid #cececa; border-radius: 8px; min-width: 150px; padding-right: 34px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 30px; border: none; background: transparent; border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QComboBox::down-arrow { image: url(icons/chevron-light.svg); width: 14px; height: 14px; }
QComboBox:hover { border-color: #566446; }
QPushButton:pressed { background: #e3e8d6; }
QComboBox QAbstractItemView { border: 1px solid #cececa; border-radius: 8px; padding: 4px; outline: none; background: #f8f8f6; color: #292929; selection-background-color: #e3e8d6; selection-color: #435435; }
QLabel#appearanceLabel { font-size: 15px; margin-top: 20px; }
QLabel#appearanceDescription, QLabel#themeStatus { color: #737370; }

QScrollBar:vertical { background: transparent; width: 12px; margin: 3px 2px; border: none; }
QScrollBar::handle:vertical { background: #cececa; min-height: 34px; border: none; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #92928e; }
QScrollBar::handle:vertical:pressed { background: #566446; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; background: transparent; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; border: none; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px 3px; border: none; }
QScrollBar::handle:horizontal { background: #cececa; min-width: 34px; border: none; border-radius: 4px; }
QScrollBar::handle:horizontal:hover { background: #92928e; }
QScrollBar::handle:horizontal:pressed { background: #566446; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; border: none; background: transparent; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; border: none; }
QAbstractScrollArea::corner { background: transparent; border: none; }
QWidget#archiveTabsHost { background: #efefed; border-bottom: 1px solid #cececa; }
QTabBar { background: transparent; qproperty-drawBase: 0; }
QTabBar::tab { background: #f1f1ee; color: #737370; border: 1px solid #cececa; border-bottom: none; border-top-left-radius: 8px; border-top-right-radius: 8px; padding: 8px 12px 8px 0px; margin-right: 4px; min-height: 22px; min-width: 85px; max-width: 220px; }
QTabBar::tab:selected { background: #e3e8d6; color: #435435; border-color: #b7c4a7; }
QTabBar::tab:hover:!selected { background: #e9ecdf; }
QTabBar::close-button { image: url(icons/close-light.svg); width: 14px; height: 14px; border: none; background: transparent; }
QWidget#tabCloseHost { background: transparent; }
QToolButton#tabCloseButton { background: transparent; border: none; border-radius: 6px; padding: 4px; }
QToolButton#tabCloseButton:hover { background: #e9ecdf; }
QToolButton#tabCloseButton:pressed { background: #e3e8d6; }
QToolButton#tabCloseButton:focus { border: 1px solid #879b76; }
QTabBar QToolButton { background: #f1f1ee; color: #292929; border: none; border-radius: 5px; }
QToolTip { background: #f8f8f6; color: #292929; border: 1px solid #cececa; border-radius: 6px; padding: 6px 8px; }
